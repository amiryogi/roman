{
  "name": "@roman/server",
  "version": "0.1.0",
  "private": true,
  "description": "Express REST API for the Roman Budhathoki website.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:sync-indexes": "tsx --env-file-if-exists=.env src/scripts/sync-indexes.ts",
    "db:sync-indexes:prod": "node dist/scripts/sync-indexes.js",
    "seed:admin": "tsx --env-file-if-exists=.env src/scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/scripts/seed-admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:content": "tsx --env-file-if-exists=.env src/scripts/seed-content.ts",
    "seed:content:prod": "node dist/scripts/seed-content.js",
    "cleanup:media": "tsx --env-file-if-exists=.env src/scripts/cleanup-orphan-media.ts",
    "cleanup:media:prod": "node dist/scripts/cleanup-orphan-media.js",
    "test:cloudinary": "tsx --env-file-if-exists=.env src/scripts/test-cloudinary.ts"
  },
  "dependencies": {
    "@roman/shared": "^0.1.0",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0"
  }
}
