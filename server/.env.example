# Server configuration (plan §21.2). Copy to server/.env for local development.

NODE_ENV=development
PORT=4000

# Local MongoDB or an Atlas development cluster (never the production database).
MONGODB_URI=mongodb://127.0.0.1:27017/roman-budhathoki

# Comma-separated exact origins allowed by CORS. Required in production.
CLIENT_ORIGINS=http://localhost:5173

# Proxy hops in front of the API (production: Vercel rewrite + Render). 0 locally.
TRUST_PROXY=0

LOG_LEVEL=info

# --- Admin authentication (plan §11) ---
# At least 32 random bytes, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=roman-budhathoki-api
JWT_AUDIENCE=roman-budhathoki-admin
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Media: Cloudinary (plan §9) ---
# From the Cloudinary console (Settings → API Keys). The secret stays on the server: never put
# these in client/.env or give them a VITE_ prefix. MEDIA_DRIVER=fake is for tests only.
MEDIA_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# One folder per environment keeps test uploads out of production. Required in production.
CLOUDINARY_ROOT_FOLDER=roman-budhathoki/development
# auto | dynamic | fixed. "auto" asks Cloudinary once, on the first upload.
CLOUDINARY_FOLDER_MODE=auto
# Upload size limits in MB. Keep them within the Cloudinary plan's limits.
MEDIA_MAX_IMAGE_MB=20
MEDIA_MAX_AUDIO_MB=100
MEDIA_MAX_VIDEO_MB=100

# Only for `npm run seed:admin` (one-off). Remove after use.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
