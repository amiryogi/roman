# Everything prefixed VITE_ is shipped to the browser. Never put secrets here (plan §21.1).
# In development /api is proxied to http://localhost:4000 by vite.config.ts.
VITE_API_BASE_URL=/api
VITE_SITE_URL=http://localhost:5173

# Public by design: it is part of every media URL. Required for production builds.
VITE_CLOUDINARY_CLOUD_NAME=

# Build time only (scripts/postbuild-seo.ts), never shipped to the browser: the API to read content
# from for the prerendered page heads, structured data and sitemap, e.g.
# https://<service>.onrender.com/api. Without it pages get titles and descriptions only.
SEO_BUILD_API_URL=
